package repository

import (
	"context"

	"{{.ModuleName}}/types/models"

	"github.com/lpphub/goweb/ext/dbx"
	"gorm.io/gorm"
)

type PostRepo struct {
	*dbx.BaseRepo[models.Post]
}

func NewPostRepo(db *gorm.DB) *PostRepo {
	return &PostRepo{
		BaseRepo: dbx.NewBaseRepo[models.Post](db),
	}
}

func (r *PostRepo) FindAll(ctx context.Context, page, pageSize int) ([]models.Post, int64, error) {
	var items []models.Post
	var total int64

	db := r.DB().WithContext(ctx).Model(&models.Post{})
	if err := db.Count(&total).Error; err != nil {
		return nil, 0, err
	}

	offset := (page - 1) * pageSize
	if err := db.Order("id DESC").Offset(offset).Limit(pageSize).Find(&items).Error; err != nil {
		return nil, 0, err
	}

	return items, total, nil
}
