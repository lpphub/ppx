package repository

import (
	"context"

	"{{.ProjectModule}}/types/models"

	"github.com/lpphub/goweb/ext/dbx"
	"gorm.io/gorm"
)

type {{.StructName}}Repo struct {
	*dbx.BaseRepo[models.{{.StructName}}]
}

func New{{.StructName}}Repo(db *gorm.DB) *{{.StructName}}Repo {
	return &{{.StructName}}Repo{
		BaseRepo: dbx.NewBaseRepo[models.{{.StructName}}](db),
	}
}

func (r *{{.StructName}}Repo) FindAll(ctx context.Context, page, pageSize int) ([]models.{{.StructName}}, int64, error) {
	var items []models.{{.StructName}}
	var total int64

	db := r.DB().WithContext(ctx).Model(&models.{{.StructName}}{})
	if err := db.Count(&total).Error; err != nil {
		return nil, 0, err
	}

	offset := (page - 1) * pageSize
	if err := db.Order("id DESC").Offset(offset).Limit(pageSize).Find(&items).Error; err != nil {
		return nil, 0, err
	}

	return items, total, nil
}
