package infra

import (
	"fmt"

	"github.com/lpphub/gost/logger"
	"github.com/lpphub/gost/otel"
	"github.com/redis/go-redis/v9"
	"gorm.io/gorm"
)

var (
	Cfg *Config
	DB  *gorm.DB
	RDB *redis.Client
)

func Init() error {
	var err error

	Cfg, err = LoadConfig()
	if err != nil {
		return fmt.Errorf("failed to load config: %w", err)
	}

	DB, err = NewMysqlDB(Cfg.Database)
	if err != nil {
		return fmt.Errorf("failed to connect to database: %w", err)
	}

	RDB, err = NewRedis(Cfg.Redis)
	if err != nil {
		return fmt.Errorf("failed to connect to redis: %w", err)
	}

	logger.Init()

	// 初始化 OpenTelemetry（traces + metrics）
	if err := otel.Init(
		otel.WithServiceName("{{.ProjectName}}"),
		otel.WithTracesEnabled(true),
	); err != nil {
		return fmt.Errorf("failed to init otel: %w", err)
	}

	return nil
}